# Copy to .env.local and fill in your Firebase project values.
# Firebase Console → Project settings → Your apps → Web app config

# Required for Auth + Firestore (client-side; must use NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Server-only. Never use the NEXT_PUBLIC_ prefix. Keep the service-account JSON out of Git.
# Same Firebase project as NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# Put the private_key on one line and keep its \n sequences.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Set to true only when this Firebase project belongs solely to TheLaptopScout.
# FIREBASE_ADMIN_REVOKE_REFRESH_TOKENS=
