# Copy to .env.local and fill in your Firebase project values.
# Firebase Console → Project settings → Your apps → Web app config

# Required for Auth + Firestore (client-side; must use NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin SDK for Force Logout All Sessions.
# Never prefix these with NEXT_PUBLIC_. Do not commit real values.
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Use the same Firebase project as NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# Store the private key as one line with \n escape sequences.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional. Leave unset unless this Firebase project is used only by TheLaptopScout.
# true also revokes every Firebase Authentication refresh token in the project,
# which signs those users out of every app that shares the project.
# The Firestore session cutoff blocks this app either way, and does not wait
# for ID tokens to expire. Refresh-token revocation does not instantly
# invalidate ID tokens that were already issued.
# FIREBASE_ADMIN_REVOKE_REFRESH_TOKENS=
